{
  "name": "@lzwme/duplicate-file-cleaner",
  "version": "2.2.0",
  "description": "一个基于 Node.js 的重复文件/重复目录/相似图片清理工具。",
  "main": "index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dfcleaner": "bin/dfcleaner.js"
  },
  "files": [
    "bin",
    "dist",
    "index.js",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": "https://github.com/lzwme/duplicate-file-cleaner.git",
  "publishConfig": {
    "registry": "https://registry.npmjs.com",
    "access": "public"
  },
  "author": {
    "name": "renxia",
    "email": "lzwy0820@qq.com",
    "url": "https://lzw.me"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cleaner",
    "duplicate",
    "duplicate-files",
    "duplicate-directories",
    "similar-images",
    "重复文件",
    "重复目录",
    "相似图片",
    "文件清理",
    "文件删除"
  ],
  "scripts": {
    "start": "pnpm dev",
    "dev": "tsc -w",
    "build": "tsc",
    "clean": "node scripts/rmdir.js ./dist",
    "pretest": "pnpm build",
    "test": "node --test test",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "release": "pnpm publish"
  },
  "dependencies": {
    "commander": "^15",
    "console-log-colors": "^0.5.0"
  },
  "peerDependencies": {
    "jimp": "^1.6.1"
  },
  "peerDependenciesMeta": {
    "jimp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26",
    "jimp": "^1.6.1",
    "typescript": "^7"
  }
}
