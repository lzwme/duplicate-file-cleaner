{
  "name": "@lzwme/duplicate-file-cleaner",
  "version": "2.0.0",
  "description": "一个基于 Node.js 的重复文件清理工具。",
  "main": "index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dfcleaner": "bin/dfcleaner.js"
  },
  "files": [
    "bin",
    "dist",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "repository": "https://github.com/lzwme/duplicate-file-cleaner.git",
  "publishConfig": {
    "registry": "https://registry.npmjs.com",
    "access": "public"
  },
  "author": {
    "name": "renxia",
    "email": "lzwy0820@qq.com",
    "url": "https://lzw.me"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cleaner",
    "重复文件",
    "文件清理",
    "图片清理",
    "相似图片",
    "文件删除"
  ],
  "scripts": {
    "start": "npm run dev",
    "dev": "tsc -w",
    "build": "tsc",
    "clean": "node scripts/rmdir.js ./dist",
    "pretest": "npm run build",
    "test": "node --test test",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "release": "npm publish"
  },
  "dependencies": {
    "commander": "^15",
    "console-log-colors": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "typescript": "^7"
  }
}
